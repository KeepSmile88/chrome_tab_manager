{
    "manifest_version": 3,
    "name": "智能标签页管理器",
    "version": "2.0",
    "description": "现代化的标签页管理工具，支持实时同步、自定义分类、自动关闭闲置标签和批量操作",
    "permissions": [
      "tabs",
      "storage",
      "activeTab",
      "scripting",
      "sidePanel",
      "windows",
      "bookmarks",
      "contextMenus",
      "clipboardRead",
      "tabGroups"
    ],
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "标签页管理器",
      "default_icon": {
        "16": "icons/icon64.png",
        "48": "icons/icon64.png",
        "128": "icons/icon96.png"
      }
    },
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "content_scripts" : [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "icons": {
      "16": "icons/icon64.png",
      "48": "icons/icon64.png",
      "128": "icons/icon96.png"
    },
    "commands": {
      "toggle-sidepanel": {
        "suggested_key": {
          "default": "Alt+T"
        },
        "description": "打开/聚焦标签管理器"
      },
      "close-all-tabs": {
        "suggested_key": {
          "default": "Alt+W"
        },
        "description": "关闭所有非固定标签"
      },
      "group-tabs": {
        "suggested_key": {
          "default": "Alt+G"
        },
        "description": "按域名分组标签"
      }
    }
  }